<bpmn:collaboration id="Colab"><bpmn:participant id="Pool" name="PUC-Rio: diagnóstico dos cursos pelo CPC (TO-BE)" processRef="Proc"/></bpmn:collaboration>
<bpmn:process id="Proc" isExecutable="false"><bpmn:laneSet id="LS"><bpmn:lane id="L_gest" name="Gestão acadêmica"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_dados" name="Equipe de dados"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S" name="Resultado do CPC divulgado"/><bpmn:task id="T1" name="Solicitar diagnóstico dos cursos"/><bpmn:task id="T2" name="Coletar e integrar CPC, Censo e painel INEP"><bpmn:property id="P_D1" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="A_D1"><bpmn:sourceRef>D1</bpmn:sourceRef><bpmn:targetRef>P_D1</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:task><bpmn:task id="T3" name="Pré-processar (3 ciclos, padronização no treino)"/><bpmn:task id="T4" name="Rodar cenários (10 divisões por execução)"><bpmn:dataOutputAssociation id="A_D2"><bpmn:targetRef>D2</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task><bpmn:exclusiveGateway id="G1" name="Grupos reais e estáveis?"/><bpmn:task id="T5" name="Revisar cenário e K"/><bpmn:task id="T6" name="Posicionar a PUC-Rio no grupo (C2)"/><bpmn:task id="T7" name="Buscar referências (k-NN)"/><bpmn:task id="T8" name="Estimar Regime esperado (Random Forest)"/><bpmn:task id="T9" name="Montar diagnóstico por indicador"/><bpmn:task id="T10" name="Discutir diagnóstico e referências"/><bpmn:task id="T11" name="Definir metas em Regime, Mestres e Doutores"/><bpmn:endEvent id="E" name="Plano de ação definido"/><bpmn:sequenceFlow id="F0" sourceRef="S" targetRef="T1"/><bpmn:sequenceFlow id="F1" sourceRef="T1" targetRef="T2"/><bpmn:sequenceFlow id="F2" sourceRef="T2" targetRef="T3"/><bpmn:sequenceFlow id="F3" sourceRef="T3" targetRef="T4"/><bpmn:sequenceFlow id="F4" sourceRef="T4" targetRef="G1"/><bpmn:sequenceFlow id="F5" sourceRef="G1" targetRef="T6" name="sim"/><bpmn:sequenceFlow id="F6" sourceRef="G1" targetRef="T5" name="não"/><bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="T4"/><bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="T7"/><bpmn:sequenceFlow id="F9" sourceRef="T7" targetRef="T8"/><bpmn:sequenceFlow id="F10" sourceRef="T8" targetRef="T9"/><bpmn:sequenceFlow id="F11" sourceRef="T9" targetRef="T10"/><bpmn:sequenceFlow id="F12" sourceRef="T10" targetRef="T11"/><bpmn:sequenceFlow id="F13" sourceRef="T11" targetRef="E"/><bpmn:dataStoreReference id="D1" name="Dados INEP (CPC, Censo, painel)"/><bpmn:dataStoreReference id="D2" name="MLflow e planilha do plano"/></bpmn:process>
