<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AS_IS" targetNamespace="https://puc-rio.br/projeto-cpc" exporter="ChatGPT" exporterVersion="1.0"><bpmn:process id="Process_AS_IS" name="AS_IS - analise de indicadores" isExecutable="false"><bpmn:laneSet id="LaneSet_AS_IS"><bpmn:lane id="Lane_AS_IS_0" name="Analista de indicadores"><bpmn:flowNodeRef>a_start</bpmn:flowNodeRef><bpmn:flowNodeRef>a_get</bpmn:flowNodeRef><bpmn:flowNodeRef>a_select</bpmn:flowNodeRef><bpmn:flowNodeRef>a_organize</bpmn:flowNodeRef><bpmn:flowNodeRef>a_analyze</bpmn:flowNodeRef><bpmn:flowNodeRef>a_report</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_AS_IS_1" name="Gestao academica"><bpmn:flowNodeRef>a_request</bpmn:flowNodeRef><bpmn:flowNodeRef>a_receive</bpmn:flowNodeRef><bpmn:flowNodeRef>a_end</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="a_start" name="Necessidade de acompanhamento"><bpmn:outgoing>as_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="a_request" name="Solicitar analise"><bpmn:incoming>as_1</bpmn:incoming><bpmn:outgoing>as_2</bpmn:outgoing></bpmn:task><bpmn:task id="a_get" name="Consultar dados Inep"><bpmn:incoming>as_2</bpmn:incoming><bpmn:outgoing>as_3</bpmn:outgoing></bpmn:task><bpmn:task id="a_select" name="Selecionar cursos e indicadores"><bpmn:incoming>as_3</bpmn:incoming><bpmn:outgoing>as_4</bpmn:outgoing></bpmn:task><bpmn:task id="a_organize" name="Organizar dados"><bpmn:incoming>as_4</bpmn:incoming><bpmn:outgoing>as_5</bpmn:outgoing></bpmn:task><bpmn:task id="a_analyze" name="Analisar resultados"><bpmn:incoming>as_5</bpmn:incoming><bpmn:outgoing>as_6</bpmn:outgoing></bpmn:task><bpmn:task id="a_report" name="Preparar sintese"><bpmn:incoming>as_6</bpmn:incoming><bpmn:outgoing>as_7</bpmn:outgoing></bpmn:task><bpmn:task id="a_receive" name="Receber e discutir sintese"><bpmn:incoming>as_7</bpmn:incoming><bpmn:outgoing>as_8</bpmn:outgoing></bpmn:task><bpmn:endEvent id="a_end" name="Analise encerrada"><bpmn:incoming>as_8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="as_1" sourceRef="a_start" targetRef="a_request" /><bpmn:sequenceFlow id="as_2" sourceRef="a_request" targetRef="a_get" /><bpmn:sequenceFlow id="as_3" sourceRef="a_get" targetRef="a_select" /><bpmn:sequenceFlow id="as_4" sourceRef="a_select" targetRef="a_organize" /><bpmn:sequenceFlow id="as_5" sourceRef="a_organize" targetRef="a_analyze" /><bpmn:sequenceFlow id="as_6" sourceRef="a_analyze" targetRef="a_report" /><bpmn:sequenceFlow id="as_7" sourceRef="a_report" targetRef="a_receive" /><bpmn:sequenceFlow id="as_8" sourceRef="a_receive" targetRef="a_end" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_AS_IS"><bpmndi:BPMNPlane id="Plane_AS_IS" bpmnElement="Process_AS_IS"><bpmndi:BPMNShape id="Shape_Lane_AS_IS_0" bpmnElement="Lane_AS_IS_0" isHorizontal="true"><dc:Bounds x="40" y="40" width="2150" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_AS_IS_1" bpmnElement="Lane_AS_IS_1" isHorizontal="true"><dc:Bounds x="40" y="220" width="2150" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_a_start" bpmnElement="a_start"><dc:Bounds x="90" y="110" width="42" height="42" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_a_request" bpmnElement="a_request"><dc:Bounds x="210" y="290" width="172" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_a_get" bpmnElement="a_get"><dc:Bounds x="420" y="110" width="172" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_a_select" bpmnElement="a_select"><dc:Bounds x="640" y="110" width="172" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_a_organize" bpmnElement="a_organize"><dc:Bounds x="860" y="110" width="172" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_a_analyze" bpmnElement="a_analyze"><dc:Bounds x="1080" y="110" width="172" height="76" /><