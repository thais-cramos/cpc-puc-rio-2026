<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TO_BE" targetNamespace="https://puc-rio.br/projeto-cpc" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:process id="Process_TO_BE" name="TO_BE - analise de indicadores" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TO_BE">
      <bpmn:lane id="Lane_TO_BE_1" name="Equipe de dados">
        <bpmn:flowNodeRef>t_get</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_features</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cluster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gate_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_gate_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TO_BE_0" name="Gestao academica">
        <bpmn:flowNodeRef>t_scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="t_start" name="Demanda de diagnostico">
      <bpmn:outgoing>tb1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_scope" name="Definir escopo e pares">
      <bpmn:incoming>tb1</bpmn:incoming>
      <bpmn:outgoing>tb2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_get" name="Obter CPC e Censo">
      <bpmn:incoming>tb2</bpmn:incoming>
      <bpmn:outgoing>tb3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_integrate" name="Integrar dados">
      <bpmn:incoming>tb3</bpmn:incoming>
      <bpmn:incoming>tb7</bpmn:incoming>
      <bpmn:outgoing>tb4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_validate" name="Validar completude e comparabilidade">
      <bpmn:incoming>tb4</bpmn:incoming>
      <bpmn:outgoing>tb5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="t_gate_data" name="Dados adequados?" gatewayDirection="Diverging">
      <bpmn:incoming>tb5</bpmn:incoming>
      <bpmn:outgoing>tb6</bpmn:outgoing>
      <bpmn:outgoing>tb8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_fix" name="Revisar selecao e tratamento">
      <bpmn:incoming>tb6</bpmn:incoming>
      <bpmn:outgoing>tb7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_features" name="Construir atributos dos dois cenarios">
      <bpmn:incoming>tb8</bpmn:incoming>
      <bpmn:outgoing>tb9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cluster" name="Executar K-means e hierarquico">
      <bpmn:incoming>tb9</bpmn:incoming>
      <bpmn:incoming>tb13</bpmn:incoming>
      <bpmn:outgoing>tb10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_evaluate" name="Avaliar e interpretar">
      <bpmn:incoming>tb10</bpmn:incoming>
      <bpmn:outgoing>tb11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="t_gate_result" name="Resultados interpretaveis?" gatewayDirection="Diverging">
      <bpmn:incoming>tb11</bpmn:incoming>
      <bpmn:outgoing>tb12</bpmn:outgoing>
      <bpmn:outgoing>tb14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_tune" name="Revisar parametros">
      <bpmn:incoming>tb12</bpmn:incoming>
      <bpmn:outgoing>tb13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_report" name="Produzir diagnosticos">
      <bpmn:incoming>tb14</bpmn:incoming>
      <bpmn:outgoing>tb15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_receive" name="Discutir diagnosticos">
      <bpmn:incoming>tb15</bpmn:incoming>
      <bpmn:outgoing>tb16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="t_end" name="Encerrar">
      <bpmn:incoming>tb16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="tb1" sourceRef="t_start" targetRef="t_scope" />
    <bpmn:sequenceFlow id="tb2" sourceRef="t_scope" targetRef="t_get" />
    <bpmn:sequenceFlow id="tb3" sourceRef="t_get" targetRef="t_integrate" />
    <bpmn:sequenceFlow id="tb4" sourceRef="t_integrate" targetRef="t_validate" />
    <bpmn:sequenceFlow id="tb5" sourceRef="t_validate" targetRef="t_gate_data" />
    <bpmn:sequenceFlow id="tb6" name="Nao" sourceRef="t_gate_data" targetRef="t_fix" />
    <bpmn:sequenceFlow id="tb7" sourceRef="t_fix" targetRef="t_integrate" />
    <bpmn:sequenceFlow id="tb8" name="Sim" sourceRef="t_gate_data" targetRef="t_features" />
    <bpmn:sequenceFlow id="tb9" sourceRef="t_features" targetRef="t_cluster" />
    <bpmn:sequenceFlow id="tb10" sourceRef="t_cluster" targetRef="t_evaluate" />
    <bpmn:sequenceFlow id="tb11" sourceRef="t_evaluate" targetRef="t_gate_result" />
    <bpmn:sequenceFlow id="tb12" name="Nao" sourceRef="t_gate_result" targetRef="t_tune" />
    <bpmn:sequenceFlow id="tb13" sourceRef="t_tune" targetRef="t_cluster" />
    <bpmn:sequenceFlow id="tb14" name="Sim" sourceRef="t_gate_result" targetRef="t_report" />
    <bpmn:sequenceFlow id="tb15" sourceRef="t_report" targetRef="t_receive" />
    <bpmn:sequenceFlow id="tb16" sourceRef="t_receive" targetRef="t_end" />
  </bpmn:process>
